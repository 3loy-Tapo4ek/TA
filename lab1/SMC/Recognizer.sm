%class SMCRecognizer
%header SMCRecognizer.hpp
%start MainMap::Start

%map MainMap
%%

//  TRANSITION              END_STATE               ACTION
Start
{
    Space                   Start                   {}
    Letter(c: char)         ReadingFirstWord        {clearBuffer(); appendBuffer(c);}
}

//  TRANSITION                     END_STATE         ACTION
ReadingFirstWord
{
    Letter(c: char)
    [ ctxt.getBufferSize() < 16 ]  ReadingFirstWord  {appendBuffer(c); }

    Digit(c: char)
    [ ctxt.getBufferSize() < 16 ]  ReadingFirstWord  {appendBuffer(c);}

    Space
    [ ctxt.isTypeKeyword() ]       ExpectVarName     {setTypeFromBuffer(); clearBuffer();}

    Space                          ExpectColon       { setDefaultType(); setVarNameFromBuffer(); clearBuffer(); }

    Colon                          ExpectEqual       { setDefaultType(); setVarNameFromBuffer(); clearBuffer(); }

}

//  TRANSITION              END_STATE               ACTION
ExpectVarName
{
    Space                   ExpectVarName           {}
    Letter(c: char)         ReadingVarName          { clearBuffer(); appendBuffer(c); }
}

//  TRANSITION                     END_STATE        ACTION
ReadingVarName
{
    Letter(c: char)
    [ ctxt.getBufferSize() < 16 ]  ReadingVarName   { appendBuffer(c); }

    Digit(c: char)
    [ ctxt.getBufferSize() < 16 ]  ReadingVarName   { appendBuffer(c); }

    Space                   ExpectColon             { setVarNameFromBuffer(); clearBuffer(); }
    Colon                   ExpectEqual             { setVarNameFromBuffer(); clearBuffer(); }
}

//  TRANSITION              END_STATE               ACTION
ExpectColon
{
    Space                   ExpectColon             {}
    Colon                   ExpectEqual             {}
}

//  TRANSITION              END_STATE               ACTION
ExpectEqual
{
    Equal                   ExpectOp1               {}
}

//  TRANSITION              END_STATE               ACTION
ExpectOp1
{
    Space                   ExpectOp1               {}
    Digit(c: char)          ReadingNumOp1           { clearBuffer(); appendBuffer(c); }
    Letter(c: char)         ReadingVarOp1           { clearBuffer(); appendBuffer(c); }
}

//  TRANSITION              END_STATE               ACTION
ReadingNumOp1
{
    Digit(c: char)          ReadingNumOp1           { appendBuffer(c); }
    Space                   ExpectSign              { clearBuffer(); }
    Op(c: char)             ExpectOp2               { clearBuffer(); }
}

//  TRANSITION                        END_STATE        ACTION
ReadingVarOp1
{
    Letter(c: char)
    [ ctxt.getBufferSize() < 16 ]     ReadingVarOp1    { appendBuffer(c); }

    Digit(c: char)
    [ ctxt.getBufferSize() < 16 ]     ReadingVarOp1    { appendBuffer(c); }

    Space
    [ ctxt.isValidVariableOperand() ] ExpectSign       { clearBuffer(); }

    Op(c: char)
    [ ctxt.isValidVariableOperand() ] ExpectOp2        { clearBuffer(); }

}

//  TRANSITION              END_STATE               ACTION
ExpectSign
{
    Space                   ExpectSign              {}
    Op(c: char)             ExpectOp2               {}
}

//  TRANSITION              END_STATE               ACTION
ExpectOp2
{
    Space                   ExpectOp2               {}
    Digit(c: char)          ReadingNumOp2           { clearBuffer(); appendBuffer(c); }
    Letter(c: char)         ReadingVarOp2           { clearBuffer(); appendBuffer(c); }
}

//  TRANSITION              END_STATE               ACTION
ReadingNumOp2
{
    Digit(c: char)          ReadingNumOp2           { appendBuffer(c); }
    Space                   ExpectEnd               { clearBuffer(); }
    EOL                     Success                 { completeSuccess(); }
}

//  TRANSITION                        END_STATE       ACTION
ReadingVarOp2
{
    Letter(c: char)
    [ ctxt.getBufferSize() < 16 ]     ReadingVarOp2   { appendBuffer(c); }

    Digit(c: char)
    [ ctxt.getBufferSize() < 16 ]     ReadingVarOp2   { appendBuffer(c); }

    Space
    [ ctxt.isValidVariableOperand() ] ExpectEnd       { clearBuffer(); }

    EOL
    [ ctxt.isValidVariableOperand() ] Success         { completeSuccess(); }

}

//  TRANSITION              END_STATE               ACTION
ExpectEnd
{
    Space                   ExpectEnd               {}
    EOL                     Success                 { completeSuccess(); }
}

//  TRANSITION              END_STATE               ACTION
Success
{
    Default                 Success                 {}
}

//  TRANSITION              END_STATE               ACTION
Error
{
    Default                 Error                   {}    
}

//  TRANSITION              END_STATE               ACTION
Default
{
    Unknown                 Error                   {}
    Default                 Error                   {}
}

%%