%class RecognizerSMC

%header "../common/Recognizer.hpp"
%include "../common/Token.hpp"

%start RecognizerMap::Pose0

%map RecognizerMap

%%

Pose0
{
    process(token: const Token&, stats: Stats&)
    [ctxt.IsType(token)]
    Pose1
    {
        pose_increment(token, stats);
    }

    process(token: const Token&, stats: Stats&)
    [ctxt.IsDelim(token)]
    nil {}

    process(token: const Token&, stats: Stats&)
    Error
    {
        alarm(token, stats);
    }
}

Pose1
{
    process(token: const Token&, stats: Stats&)
    [ctxt.IsName(token)]
    Pose2
    {
        pose_increment(token, stats);
    }

    process(token: const Token&, stats: Stats&)
    Error
    {
        alarm(token, stats);
    }
}

Pose2
{
    process(token: const Token&, stats: Stats&)
    [ctxt.IsAssign(token)]
    Pose3
    {
        pose_increment(token, stats);
    }

    process(token: const Token&, stats: Stats&)
    Error
    {
        alarm(token, stats);
    }
}

Pose3
{
    process(token: const Token&, stats: Stats&)
    [ctxt.IsLit(token)]
    Pose4
    {
        pose_increment(token, stats);
    }

    process(token: const Token&, stats: Stats&)
    Error
    {
        alarm(token, stats);
    }
}

Pose4
{
    process(token: const Token&, stats: Stats&)
    [ctxt.IsOperator(token)]
    Pose5
    {
        pose_increment(token, stats);
    }

    process(token: const Token&, stats: Stats&)
    Error
    {
        alarm(token, stats);
    }
}

Pose5
{
    process(token: const Token&, stats: Stats&)
    [ctxt.IsLit(token)]
    Pose6
    {
        pose_increment(token, stats);
    }

    process(token: const Token&, stats: Stats&)
    Error
    {
        alarm(token, stats);
    }
}

Pose6
{
    process(token: const Token&, stats: Stats&)
    [ctxt.IsDelim(token)]
    Pose0
    {
        pose_restart(token, stats);
    }

    process(token: const Token&, stats: Stats&)
    Error
    {
        alarm(token, stats);
    }
}

Error
{
    process(token: const Token&, stats: Stats&)
    [ctxt.IsDelim(token)]
    Pose0 {}

    process(token: const Token&, stats: Stats&)
    [ ctxt.IsType(token) ]
    Pose1 
    {
        restart_from_error(token, stats);
    }

    process(token: const Token&, stats: Stats&)
    nil {}
}

%%